diff --git a/internal/timescale/timescale.go b/internal/timescale/timescale.go
new file mode 100644
index 0000000..ce96517
--- /dev/null
+++ b/internal/timescale/timescale.go
@@ -0,0 +1,42 @@
+// Package timescale shrinks cara's liveness, failover, cleanup and recovery
+// deadlines by one factor, so end-to-end tests that wait on them finish
+// sooner. It exists only in test builds: the course project applies it as a
+// patch when it builds the binaries, and the committed product code never
+// contains it.
+//
+// CARA_TIME_SCALE is a factor in (0, 1]. Unset, unparsable or out of range
+// means 1, which leaves every deadline as shipped. Every scaled deadline is
+// multiplied by the same factor, so their order is kept: the heartbeat
+// interval stays below the heartbeat timeout, which stays below the running
+// grace period, and so on. Scaling only some of them would test a system
+// that does not exist.
+package timescale
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"time"
+)
+
+var factor = load()
+
+func load() float64 {
+	raw := os.Getenv("CARA_TIME_SCALE")
+	if raw == "" {
+		return 1
+	}
+	f, err := strconv.ParseFloat(raw, 64)
+	if err != nil || f <= 0 || f > 1 {
+		fmt.Fprintf(os.Stderr, "timescale: ignoring CARA_TIME_SCALE=%q, using 1\n", raw)
+		return 1
+	}
+	fmt.Fprintf(os.Stderr, "timescale: deadlines scaled by %g\n", f)
+	return f
+}
+
+// D scales one deadline.
+func D(d time.Duration) time.Duration { return time.Duration(float64(d) * factor) }
+
+// Factor reports the factor in use.
+func Factor() float64 { return factor }
